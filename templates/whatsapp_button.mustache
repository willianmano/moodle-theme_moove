{{!
    @template theme_moove/whatsapp_button

    Floating WhatsApp contact button, shown site-wide when enabled in the theme settings.

    Context variables required for this template:
    * showwhatsappbutton - Whether the button should be displayed.
    * whatsappbuttonurl - The wa.me/api.whatsapp.com link to open.

    Example context (json):
    {
        "showwhatsappbutton": true,
        "whatsappbuttonurl": "https://api.whatsapp.com/send?phone=5511999999999"
    }
}}
{{#showwhatsappbutton}}
    <a href="{{whatsappbuttonurl}}"
        class="moove-whatsapp-float"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="{{#str}}contactonwhatsapp, theme_moove{{/str}}"
        title="{{#str}}contactonwhatsapp, theme_moove{{/str}}">
        <i class="fa fa-whatsapp" aria-hidden="true"></i>
    </a>
{{/showwhatsappbutton}}
